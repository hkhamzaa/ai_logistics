# ─────────────────────────────────────────────
# AI Logistics Operating System — Environment
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# ── Server ───────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database ─────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgresql://logistics:logistics_dev@localhost:5432/logistics_os

# ── Agent behaviour ──────────────────────────
# Set to true to log all actions but make ZERO external API calls.
# Must be explicitly set to false to enable live integrations.
AGENT_DRY_RUN=true

# Simulation tick interval in milliseconds (default 5000 = 5s)
SIMULATION_TICK_MS=5000

# ── Google Maps ───────────────────────────────
# Server-side key: used by the Node backend for Directions / Routes API.
# No HTTP-referrer restriction required; keep it server-side only.
GOOGLE_MAPS_SERVER_KEY=your_server_maps_key_here

# Browser key: sent to the React client. Restrict to your dev/prod origin
# in the Google Cloud Console (HTTP referrer restriction).
GOOGLE_MAPS_BROWSER_KEY=your_browser_maps_key_here

# ── Slack ─────────────────────────────────────
# OAuth bot token with chat:write scope.
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# Channel name or ID where ops alerts are posted.
SLACK_CHANNEL=#logistics-ops

# ── Twilio ────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Use +15005550006 for Twilio test credentials during development.
TWILIO_FROM_NUMBER=+15005550006

# ── PayPal ────────────────────────────────────
# Set to "live" only after deliberate review — triggers a startup warning.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret

# ── Refund guardrails ─────────────────────────
# Refunds at or below this USD amount are auto-approved; above goes to the queue.
REFUND_AUTO_APPROVE_LIMIT=50
# Maximum percentage of shipment value that can be refunded (0–100).
REFUND_MAX_PCT=50
# Maximum USD amount for a single auto-refund.
REFUND_MAX_AMOUNT=200
# Daily circuit breaker: max number of auto-refunds before halting.
REFUND_DAILY_MAX_COUNT=10
# Daily circuit breaker: max total USD refunded before halting.
REFUND_DAILY_MAX_AMOUNT=500
